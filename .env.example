TELEGRAM_SOLVER_BOT_TOKEN=your_new_telegram_bot_token
TELEGRAM_OWNER_ID=123456789
ENCRYPTION_KEY=your_fernet_encryption_key
# Legacy Telegram-only fallback. Dashboard users add their own private key in
# Dashboard > AI settings; their jobs never use this shared environment key.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional fallbacks when AI_PROVIDER is openai or gemini for Telegram-only accounts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Issues are discovered across GitHub by assignment and label. Comma-separated;
# an issue matching any listed label is eligible.
PROGRAM_LABELS=GrantFox OSS,Stellar Wave
ASSIGNMENT_POLL_SECONDS=300
SOLVER_MAX_TURNS=30
SOLVER_REPAIR_MAX_TURNS=16
SOLVER_MAX_REPAIR_ATTEMPTS=2
SOLVER_CONCURRENCY=3

# Hosted Postgres URLs (Neon, Supabase, Render) work as-is; libpq-only query
# parameters like sslmode are translated for asyncpg automatically.
DATABASE_URL=sqlite+aiosqlite:///./solver.db

# Deployment shape. Leave both unset for a single always-on process.
# Set RUN_BACKGROUND_WORKERS=false when .github/workflows/solver.yml runs the
# poller and solver on a schedule, so the web service can idle instead of
# holding the host awake 24/7.
RUN_BACKGROUND_WORKERS=true
# polling (default) | webhook | off. Webhook mode is required on a host that
# spins down when idle, since long polling dies with the process.
TELEGRAM_MODE=polling
# Required only when TELEGRAM_MODE=webhook.
TELEGRAM_WEBHOOK_BASE=
TELEGRAM_WEBHOOK_SECRET=
# Seconds a scheduled cycle may keep claiming new jobs before winding down.
CYCLE_MAX_SECONDS=2700

# Optional web dashboard at /dashboard. Leave DASHBOARD_PASSWORD unset to keep
# it disabled. These become the initial admin's login (each person you add
# after that gets their own login, created from the admin panel).
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Set to false only for local http://localhost testing.
DASHBOARD_COOKIE_SECURE=true
